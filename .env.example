# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (Project Settings -> API) -------------------------------------
# Safe to expose to the browser: access is governed by Row Level Security.
# If your host will not store a NEXT_PUBLIC_ value, the same settings also work as
# SUPABASE_URL, SUPABASE_ANON_KEY and SITE_URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional, server-only. Bypasses RLS. Used ONLY by `npm run seed` to create the admin
# account; the web app itself never reads it. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the site, used in auth e-mail links (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Telegram order notifications (optional, server-only) -------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids. The legacy id1 / id2 variables are still honoured.
TELEGRAM_CHAT_IDS=

# --- Seeding (used by `npm run seed`): the admin account to create / seed as --
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
