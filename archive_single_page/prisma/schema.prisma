generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  customer
  vendor
  admin

  @@map("user_role")
}

enum RestaurantStatus {
  open
  busy
  closed

  @@map("restaurant_status")
}

enum OrderStatus {
  pending
  confirmed
  preparing
  ready
  out_for_delivery
  delivered
  cancelled

  @@map("order_status")
}

enum DiscountType {
  percent
  fixed

  @@map("discount_type")
}

model Profile {
  id         String     @id @default(uuid()) @db.Uuid
  email      String?
  fullName   String     @default("") @map("full_name")
  phone      String?
  avatarUrl  String?    @map("avatar_url")
  role       UserRole   @default(customer)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  restaurants Restaurant[]

  @@map("profiles")
}

model DeliveryLocation {
  id        Int      @id @default(autoincrement())
  nameEn    String   @map("name_en")
  nameAr    String?  @map("name_ar")
  nameKu    String?  @map("name_ku")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  orders    Order[]

  @@map("delivery_locations")
}

model Restaurant {
  id           String           @id @default(uuid()) @db.Uuid
  ownerId      String?          @map("owner_id") @db.Uuid
  slug         String           @unique
  nameEn       String           @map("name_en")
  nameAr       String?          @map("name_ar")
  nameKu       String?          @map("name_ku")
  descriptionEn String?         @map("description_en")
  descriptionAr String?         @map("description_ar")
  descriptionKu String?         @map("description_ku")
  logoUrl      String?          @map("logo_url")
  coverUrl     String?          @map("cover_url")
  phone        String?
  location     String?
  opensAt      DateTime?        @map("opens_at") @db.Time
  closesAt     DateTime?        @map("closes_at") @db.Time
  deliveryFee  Int              @default(0) @map("delivery_fee")
  minOrder     Int              @default(0) @map("min_order")
  prepMinutes  Int              @default(20) @map("prep_minutes")
  status       RestaurantStatus @default(open)
  isActive     Boolean          @default(true) @map("is_active")
  isFeatured   Boolean          @default(false) @map("is_featured")
  ratingAvg    Decimal          @default(0) @map("rating_avg") @db.Decimal(2, 1)
  ratingCount  Int              @default(0) @map("rating_count")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  owner        Profile?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  categories   Category[]
  menuItems    MenuItem[]
  promotions   Promotion[]
  orders       Order[]

  @@map("restaurants")
}

model Category {
  id           String      @id @default(uuid()) @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  nameEn       String      @map("name_en")
  nameAr       String?     @map("name_ar")
  nameKu       String?     @map("name_ku")
  noteEn       String?     @map("note_en")
  noteAr       String?     @map("note_ar")
  noteKu       String?     @map("note_ku")
  sortOrder    Int         @default(0) @map("sort_order")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]

  @@map("categories")
}

model MenuItem {
  id           String        @id @default(uuid()) @db.Uuid
  restaurantId String        @map("restaurant_id") @db.Uuid
  categoryId   String?       @map("category_id") @db.Uuid
  nameEn       String        @map("name_en")
  nameAr       String?       @map("name_ar")
  nameKu       String?       @map("name_ku")
  descriptionEn String?      @map("description_en")
  descriptionAr String?      @map("description_ar")
  descriptionKu String?      @map("description_ku")
  price        Int
  imageUrl     String?       @map("image_url")
  isAvailable  Boolean       @default(true) @map("is_available")
  prepMinutes  Int?          @map("prep_minutes")
  sortOrder    Int           @default(0) @map("sort_order")
  orderCount   Int           @default(0) @map("order_count")
  archivedAt   DateTime?     @map("archived_at") @db.Timestamptz
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  optionGroups OptionGroup[]
  orderItems   OrderItem[]

  @@map("menu_items")
}

model OptionGroup {
  id        String   @id @default(uuid()) @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  nameEn    String   @map("name_en")
  nameAr    String?  @map("name_ar")
  nameKu    String?  @map("name_ku")
  minSelect Int      @default(0) @map("min_select")
  maxSelect Int      @default(1) @map("max_select")
  sortOrder Int      @default(0) @map("sort_order")

  item      MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  options   Option[]

  @@map("option_groups")
}

model Option {
  id         String      @id @default(uuid()) @db.Uuid
  groupId    String      @map("group_id") @db.Uuid
  nameEn     String      @map("name_en")
  nameAr     String?     @map("name_ar")
  nameKu     String?     @map("name_ku")
  priceDelta Int         @default(0) @map("price_delta")
  isAvailable Boolean    @default(true) @map("is_available")
  sortOrder  Int         @default(0) @map("sort_order")

  group      OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("options")
}

model Promotion {
  id           String       @id @default(uuid()) @db.Uuid
  restaurantId String?      @map("restaurant_id") @db.Uuid
  code         String       @unique
  titleEn      String       @map("title_en")
  titleAr      String?      @map("title_ar")
  titleKu      String?      @map("title_ku")
  discountType DiscountType @map("discount_type")
  value        Int
  minSubtotal  Int          @default(0) @map("min_subtotal")
  maxDiscount  Int?         @map("max_discount")
  startsAt     DateTime?    @map("starts_at") @db.Timestamptz
  endsAt       DateTime?    @map("ends_at") @db.Timestamptz
  usageLimit   Int?         @map("usage_limit")
  perUserLimit Int          @default(1) @map("per_user_limit")
  usedCount    Int          @default(0) @map("used_count")
  isActive     Boolean      @default(true) @map("is_active")
  isPublic     Boolean      @default(true) @map("is_public")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  restaurant   Restaurant?  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@map("promotions")
}

model Order {
  id             String            @id @default(uuid()) @db.Uuid
  orderNumber    BigInt            @unique @default(autoincrement()) @map("order_number")
  trackingToken  String            @default(uuid()) @map("tracking_token") @db.Uuid
  restaurantId   String            @map("restaurant_id") @db.Uuid
  locationId     Int?              @map("location_id")
  promotionId    String?           @map("promotion_id") @db.Uuid
  customerName   String            @map("customer_name")
  customerPhone  String            @map("customer_phone")
  deliveryDetails String?          @map("delivery_details")
  comment        String?
  status         OrderStatus       @default(pending)
  subtotal       Int
  deliveryFee    Int               @default(0) @map("delivery_fee")
  discount       Int               @default(0)
  total          Int
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  restaurant     Restaurant        @relation(fields: [restaurantId], references: [id])
  location       DeliveryLocation? @relation(fields: [locationId], references: [id])
  promotion      Promotion?        @relation(fields: [promotionId], references: [id])
  orderItems     OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  nameEn    String   @map("name_en")
  nameAr    String?  @map("name_ar")
  nameKu    String?  @map("name_ku")
  quantity  Int      @default(1)
  unitPrice Int      @map("unit_price")
  totalPrice Int     @map("total_price")

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item      MenuItem @relation(fields: [itemId], references: [id])

  @@map("order_items")
}
